{
  "name": "dsh-doc-import",
  "version": "0.1.0",
  "description": "dsh web GUI 文档导入插件：拖入/粘贴/选择 txt/md/csv/docx/pdf，host 端自动解析文本并内联进用户消息；扫描版 PDF 逐页自动 OCR（deepseek-v4-flash-vision-exp）；超限截断 + read_document 工具回读全文；>50k 字符发送前弹预计 token/费用提示。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.2.108",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-client.mjs && node ../../scripts/wrap-client.mjs",
    "build:client": "node ../../scripts/build-client.mjs && node ../../scripts/wrap-client.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "watch:client": "node ../../scripts/build-client.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/parsers.test.mjs"
  }
}
